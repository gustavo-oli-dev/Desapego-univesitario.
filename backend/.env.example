# Credenciais de email (SMTP) para enviar os códigos de verificação de verdade.
# Copie este arquivo para ".env" e preencha. Sem isso, o app mostra o código na tela.
#
# Gmail (recomendado p/ testes):
#   1. Ative a verificação em 2 etapas na conta Google.
#   2. Gere uma "Senha de app": https://myaccount.google.com/apppasswords
#   3. Preencha abaixo (a senha de app tem 16 letras, sem espaços).
EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA_APP=xxxxxxxxxxxxxxxx
# Opcionais (padrão já é Gmail):
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORTA=587
